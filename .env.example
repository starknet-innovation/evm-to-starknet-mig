# Required for real Ethereum balances and RPC reads.
ALCHEMY_API_KEY=
NEXT_PUBLIC_ALCHEMY_RPC_URL=

# Required for WalletConnect mobile wallets. Injected wallets work without it.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# Starknet mainnet RPC used to verify account deployment and SNIP-12 signatures.
STARKNET_RPC_URL=https://starknet-mainnet.public.blastapi.io/rpc/v0_10

# Recommended in production. Development falls back to an in-memory store.
DATABASE_URL=

# Development/ephemeral previews only. Keep false for mainnet deployments.
ALLOW_IN_MEMORY_PERSISTENCE=false

# Mainnet writes are disabled unless explicitly enabled.
NEXT_PUBLIC_ENABLE_MAINNET_EXECUTION=false

# Development-only fixture flow. Ignored in production unless explicitly true.
ALLOW_DEMO_MODE=true

# Keep false in production: a live registry outage should fail route planning closed.
ALLOW_STARKGATE_REGISTRY_FALLBACK=false

# ETH left behind for Ethereum gas, in wei (default is 0.015 ETH).
ETH_GAS_RESERVE_WEI=15000000000000000
